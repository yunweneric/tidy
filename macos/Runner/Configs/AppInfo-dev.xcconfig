// The dev flavour: what you run from source.
//
// A separate install rather than a separate build of one install. The three
// overrides below are the whole of it — name, identity, icon — and each buys
// something concrete:
//
//   PRODUCT_NAME               "Tidy Dev" in the Dock, the app switcher and
//                              the title bar, so a debug window is never
//                              mistaken for the real one. Mirrored on the Dart
//                              side by `Brand.displayName`.
//
//   PRODUCT_BUNDLE_IDENTIFIER  Its own TCC record. Full Disk Access granted to
//                              a debug build must not be granted to the
//                              shipping app, and revoking one must not revoke
//                              the other. `AppSupport.directoryName` also reads
//                              the `.dev` suffix to pick the Application
//                              Support folder, so dev writes to `Tidy Dev`
//                              and cannot lock or corrupt the real store.
//
//   ASSETCATALOG_...APPICON    The amber tile. Same mark, different ramp —
//                              generated by `scripts/generate_icons.py`, which
//                              writes `AppIcon-dev.appiconset` straight into
//                              the asset catalog.

#include "AppInfo.xcconfig"

PRODUCT_NAME = Tidy Dev
PRODUCT_BUNDLE_IDENTIFIER = com.yunweneric.tidy.dev
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon-dev
